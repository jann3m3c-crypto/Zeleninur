# Put these in your hosting provider's private Environment Variables, not in source control.
ZELENINUR_DATA_DIR=/data
ZELENINUR_DB_PATH=/data/zeleninur.db
ZELENINUR_SECRET=generate-a-unique-random-secret-value
ZELENINUR_ALLOW_DEMO_USERS=false
ZELENINUR_ADMIN_USERNAME=choose-your-own-admin-name
ZELENINUR_ADMIN_PASSWORD=choose-a-long-unique-password
